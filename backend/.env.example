# Plantilla de variables de entorno — copiar a .env y completar.
# Los valores reales NUNCA se suben al repositorio (gestión segura de secrets).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5544/master_gateway?schema=public"
PORT=3000

# Firma de JWT — generar un valor aleatorio fuerte (>= 48 bytes)
JWT_SECRET="CAMBIAR_POR_VALOR_ALEATORIO_SEGURO"
JWT_TEMP_EXPIRES_IN="5m"
JWT_ACCESS_EXPIRES_IN="15m"
REFRESH_TOKEN_DAYS=7